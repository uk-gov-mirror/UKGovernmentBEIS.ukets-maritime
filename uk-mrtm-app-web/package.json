{
  "name": "uk-mrtm-app-web",
  "version": "0.81.0",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "postinstall": "node git-version.js && yarn prebuild",
    "ng": "ng",
    "start": "ng serve --serve-path /maritime/",
    "test:govuk-components": "ng test govuk-components --no-watch",
    "test:govuk-components:watch": "ng test govuk-components",
    "test:govuk-components:coverage": "ng test govuk-components --no-watch --coverage",
    "test:common": "ng test common --no-watch",
    "test:common:watch": "ng test common",
    "test:common:coverage": "ng test common --no-watch --coverage",
    "test:app": "ng test uk-mrtm-app-web --no-watch",
    "test:app:watch": "ng test uk-mrtm-app-web",
    "test:app:coverage": "ng test uk-mrtm-app-web --no-watch --coverage",
    "build:govuk-components": "ng build govuk-components",
    "build:govuk-components:watch": "ng build govuk-components --watch",
    "build:mrtm-api": "ng build mrtm-api",
    "build:common": "ng build common",
    "build:common:watch": "ng build common --watch",
    "prebuild": "yarn build:govuk-components && yarn build:mrtm-api && yarn build:common",
    "build": "ng build",
    "prebuild:production": "yarn build:govuk-components && yarn build:mrtm-api && yarn build:common",
    "build:production": "ng build",
    "generate:api": "rimraf projects/mrtm-api/src/lib && openapi-generator-cli generate --openapitools projects/mrtm-api/openapitools.json",
    "postgenerate:api": "rimraf projects/mrtm-api/src/lib/.openapi-generator && ng lint mrtm-api --fix && git add projects/mrtm-api/src/lib && yarn build:mrtm-api",
    "lint": "ng lint",
    "release:patch": "yarn version --patch --no-commit-hooks --no-git-tag-version && conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:minor": "yarn version --minor --no-commit-hooks --no-git-tag-version && conventional-changelog -p angular -i CHANGELOG.md -s",
    "release:major": "yarn version --major --no-commit-hooks --no-git-tag-version && conventional-changelog -p angular -i CHANGELOG.md -s",
    "sonar": "sonar-scanner",
    "sonar:local": "sonar-scanner -Dsonar.host.url=http://localhost:9000 -Dsonar.login=admin -Dsonar.password=admin"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "bignumber.js": "^9.3.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "immer": "^11.1.16",
    "keycloak-js": "25.0.6",
    "libphonenumber-js": "^1.13.10",
    "papaparse": "^5.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "24.13.3",
    "@types/papaparse": "^5.3.16",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "22.1.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-extra": "^10.1.0",
    "git-branch": "^2.0.1",
    "git-describe": "^4.1.1",
    "govuk-frontend": "6.1.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "prettier-eslint": "^16.4.2",
    "rimraf": "^6.1.3",
    "sonar-scanner": "^3.1.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
