<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        logicalFilePath="v0.2.0/account_details_history.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="0_2_0_create_table_account_details_history" author="pkouris">
        <createSequence sequenceName="account_details_history_seq"
                         minValue="0"
                         maxValue="999999999999999999"
                         incrementBy="1"
                         startValue="1"
                         cycle="false"/>

        <createTable tableName="account_details_history"
                     remarks="Represents an account details history entry">
            <column name="id" type="bigint" remarks="The account details history entry id">
                <constraints primaryKey="true"
                             primaryKeyName="account_details_history_pk"
                             nullable="false"/>
            </column>

            <column name="account_id" type="bigint"
                    remarks="The account id to which the history entry refers to">
                <constraints nullable="false"
                             foreignKeyName="fk_account_details_history_account"
                             referencedTableName="account_mrtm"
                             referencedColumnNames="id"/>
            </column>

            <column name="creation_date" type="timestamp"
                    remarks="When the update occurred">
                <constraints nullable="false"/>
            </column>

            <column name="submitter_name" type="varchar(255)"
                    remarks="Who changed the account details. Can be the SYSTEM or user">
                <constraints nullable="false"/>
            </column>

            <column name="submitter_id" type="varchar(255)"
                    remarks="The ID of the user that changed the account details">
                <constraints nullable="true"/>
            </column>

            <column name="previous_value" type="jsonb" remarks="Snapshot of tracked values before the update">
                <constraints nullable="false"/>
            </column>

            <column name="new_value" type="jsonb" remarks="Snapshot of tracked values after the update">
                <constraints nullable="false"/>
            </column>

            <column name="reason" type="varchar(10000)"
                    remarks="Reason for the update (free text)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex indexName="idx_account_details_history_account_id"
                     tableName="account_details_history">
            <column name="account_id"/>
        </createIndex>

        <rollback>
            <sql>
                DROP INDEX IF EXISTS idx_account_details_history_account_id;
                DROP TABLE IF EXISTS account_details_history;
                DROP SEQUENCE IF EXISTS account_details_history_seq;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
