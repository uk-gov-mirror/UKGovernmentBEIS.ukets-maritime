<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        logicalFilePath="v0.2.0/site_visit.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="0_1_0_CREATE_SITE_VISIT_TABLE" author="P44065">
        <createTable tableName="site_visit">
            <column name="id" type="varchar(20)">
                <constraints primaryKey="true" primaryKeyName="site_visit_pk" nullable="false"/>
            </column>
            <column name="data" type="jsonb">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="year" type="int">
                <constraints nullable="false" />
            </column>
        </createTable>
        <rollback>
            <sql>
                DROP TABLE IF EXISTS site_visit CASCADE;
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>