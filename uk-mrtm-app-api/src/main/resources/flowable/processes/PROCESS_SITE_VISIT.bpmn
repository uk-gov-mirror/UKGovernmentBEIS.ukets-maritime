  <process id="PROCESS_SITE_VISIT" name="Site Visit Process" isExecutable="true">
    <userTask id="SITE_VISIT_APPLICATION_SUBMIT" name="Operator:Submit Site Visit Aplication" flowable:formFieldValidation="true" />
    <startEvent id="ApplyForPermitStartEvent" name="Start" flowable:formFieldValidation="true" />
    <sequenceFlow id="Flow_0zyf2mz" sourceRef="SITE_VISIT_APPLICATION_SUBMIT" targetRef="Gateway_0i8cpil" />
    <sequenceFlow id="Flow_0az5ca4" sourceRef="ApplyForPermitStartEvent" targetRef="SITE_VISIT_APPLICATION_SUBMIT" />
    <exclusiveGateway id="Gateway_19o6n11" name="what is the review determination?" />
    <endEvent id="Event_0ol6ie2">
      <incoming>Flow_1nd1hdr</incoming>
    </endEvent>
    <sequenceFlow id="Flow_0r2teah" name="rejected" sourceRef="Gateway_19o6n11" targetRef="Activity_0do5bqu">
      <conditionExpression xsi:type="tFormalExpression">${reviewDetermination=='REJECTED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1j8ek33" name="approved" sourceRef="Gateway_19o6n11" targetRef="Activity_014ftb6">
      <conditionExpression xsi:type="tFormalExpression">${reviewDetermination=='APPROVED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1p48t5z" sourceRef="Activity_014ftb6" targetRef="Activity_11xkdzc" />
    <callActivity id="SITE_VISIT_REVIEW" name="Review Site Visit Application" calledElement="APPL_REVIEW" flowable:calledElementType="key" flowable:businessKey="#{businessKey}" flowable:fallbackToDefaultTenant="false">
      <extensionElements>
        <flowable:in source="requestId" target="requestId" />
        <flowable:in source="requestType" target="requestType" />
        <flowable:in source="businessKey" target="businessKey" />
        <flowable:in source="skipPayment" target="skipPayment" />
        <flowable:out source="reviewDetermination" target="reviewDetermination" />
      </extensionElements>
      <incoming>Flow_0sxgld1</incoming>
    </callActivity>
    <sequenceFlow id="Flow_1hmzmrq" sourceRef="SITE_VISIT_REVIEW" targetRef="Gateway_19o6n11" />
    <serviceTask id="Activity_014ftb6" name="Handle Site Visit Approved" flowable:delegateExpression="#{siteVisitApprovedHandler}" />
    <serviceTask id="Activity_0qgk5of" name="Update Workflow status to ACCEPTED" flowable:delegateExpression="#{requestUpdateStatusHandlerFlowable}">
      <extensionElements>
        <flowable:field name="requestStatus">
          <flowable:string>ACCEPTED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_1yl4zkz" sourceRef="Activity_0qgk5of" targetRef="Event_0ol6ie2" />
    <serviceTask id="Activity_01z2zx8" name="Add Approved Request Action" flowable:delegateExpression="#{siteVisitApprovedAddRequestActionHandler}" />
    <sequenceFlow id="Flow_06aoewy" sourceRef="Activity_01z2zx8" targetRef="Activity_0mhbb4f" />
    <serviceTask id="Activity_0xyg4pv" name="Add Rejected Request Action" flowable:delegateExpression="#{siteVisitRejectedAddRequestActionHandler}" />
    <sequenceFlow id="Flow_0sgt8le" sourceRef="Activity_0xyg4pv" targetRef="Activity_1h8mfcp" />
    <serviceTask id="Activity_0i0nftz" name="Update Workflow status to REJECTED" flowable:delegateExpression="#{requestUpdateStatusHandlerFlowable}">
      <extensionElements>
        <flowable:field name="requestStatus">
          <flowable:string>REJECTED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_0t9cftc" sourceRef="Activity_0i0nftz" targetRef="Event_0ol6ie2" />
    <serviceTask id="Activity_11xkdzc" name="Generate approved documents" flowable:delegateExpression="#{siteVisitApprovedGenerateOfficialNoticeHandler}" />
    <sequenceFlow id="Flow_0glekzj" sourceRef="Activity_11xkdzc" targetRef="Activity_01z2zx8" />
    <serviceTask id="Activity_0do5bqu" name="Generate rejected official notice" flowable:delegateExpression="#{siteVisitRejectedGenerateOfficialNoticeHandler}" />
    <sequenceFlow id="Flow_0uznhmg" sourceRef="Activity_0do5bqu" targetRef="Activity_0xyg4pv" />
    <serviceTask id="Activity_0mhbb4f" name="Send Official Notice Email" flowable:delegateExpression="#{siteVisitSendOfficialNoticeEmailHandler}" />
    <sequenceFlow id="Flow_0tu7sxd" sourceRef="Activity_0mhbb4f" targetRef="Activity_0qgk5of" />
    <serviceTask id="Activity_1h8mfcp" name="Send Official Notice Email" flowable:delegateExpression="#{siteVisitSendOfficialNoticeEmailHandler}" />
    <sequenceFlow id="Flow_0sgt2lx" sourceRef="Activity_1h8mfcp" targetRef="Activity_0i0nftz" />
    <exclusiveGateway id="Gateway_0i8cpil" name="what is the submit outcome?">
      <incoming>Flow_0zyf2mz</incoming>
      <outgoing>Flow_0sxgld1</outgoing>
      <outgoing>Flow_1bbkd9n</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_0sxgld1" sourceRef="Gateway_0i8cpil" targetRef="SITE_VISIT_REVIEW">
      <conditionExpression xsi:type="tFormalExpression">${siteVisitSubmitOutcome=='SUBMITTED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1bbkd9n" name="cancelled" sourceRef="Gateway_0i8cpil" targetRef="Activity_1jprnvc">
      <conditionExpression xsi:type="tFormalExpression">${siteVisitSubmitOutcome=='CANCELLED'}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="Activity_1jprnvc" name="Handle Site Visit Cancelled" flowable:delegateExpression="#{siteVisitAddCancelledRequestActionHandler}" />
    <sequenceFlow id="Flow_10wq9fa" sourceRef="Activity_1jprnvc" targetRef="Activity_1ijkbec" />
    <serviceTask id="Activity_1ijkbec" name="Update Workflow status to CANCELLED" flowable:delegateExpression="#{requestUpdateStatusHandlerFlowable}">
        <extensionElements>
          <flowable:field name="requestStatus">
            <flowable:string>CANCELLED</flowable:string>
          </flowable:field>
        </extensionElements>
    </serviceTask>
    <sequenceFlow id="Flow_1nd1hdr" sourceRef="Activity_1ijkbec" targetRef="Event_0ol6ie2" />
    <textAnnotation id="TextAnnotation_057v3nk">
      <text>requestId</text>
    </textAnnotation>
    <association id="Association_12t8i82" associationDirection="None" sourceRef="ApplyForPermitStartEvent" targetRef="TextAnnotation_057v3nk" />
  </process>
