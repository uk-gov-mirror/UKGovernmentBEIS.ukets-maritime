    <sequenceFlow id="Flow_1ct78xy" sourceRef="Activity_1snl8xz" targetRef="EMP_VARIATION_REGULATOR_LED_APPLICATION_SUBMIT" />
    <textAnnotation id="TextAnnotation_105sg2r">
      <text>requestId</text>
    </textAnnotation>
    <association id="Association_0imzgfa" associationDirection="None" sourceRef="Event_18hebpn" targetRef="TextAnnotation_105sg2r" />
