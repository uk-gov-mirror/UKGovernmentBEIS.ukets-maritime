    <sequenceFlow id="Flow_0iaydw6" sourceRef="Activity_0bhmh2k" targetRef="Activity_1mrf0cx" />
    <exclusiveGateway id="Gateway_1gblt35" name="is peer review required?" />
    <sequenceFlow id="Flow_1y2n251" name="no" sourceRef="Gateway_1gblt35" targetRef="Activity_1npk75e">
      <conditionExpression xsi:type="tFormalExpression">${reviewOutcome!='PEER_REVIEW_REQUIRED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_0wgfbkz" sourceRef="Activity_1npk75e" targetRef="Activity_1t4bki7" />
    <serviceTask id="Activity_1npk75e" name="Handle EMP&#10;Variation Approved" flowable:delegateExpression="#{empVariationRegulatorLedUpdateEmpUponSubmitHandlerFlowable}" />
    <callActivity id="Activity_0es14d0" name="Peer Review" calledElement="PEER_REVIEW" flowable:calledElementType="key" flowable:businessKey="#{businessKey}" flowable:inheritVariables="true" flowable:fallbackToDefaultTenant="false" />
    <sequenceFlow id="Flow_05zybuf" name="yes" sourceRef="Gateway_1gblt35" targetRef="Activity_0es14d0">
      <conditionExpression xsi:type="tFormalExpression">${reviewOutcome=='PEER_REVIEW_REQUIRED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1tc0wml" name="submitted" sourceRef="Gateway_1p5poiy" targetRef="Gateway_1gblt35" />
    <sequenceFlow id="Flow_1mb9bwg" name="cancelled" sourceRef="Gateway_1p5poiy" targetRef="Activity_0bhmh2k">
      <conditionExpression xsi:type="tFormalExpression">${empVariationSubmitOutcome=='CANCELLED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1ugr8qr" sourceRef="Activity_0es14d0" targetRef="EMP_VARIATION_REGULATOR_LED_APPLICATION_SUBMIT" />
    <sequenceFlow id="Flow_0ru8iix" sourceRef="Activity_1t4bki7" targetRef="Activity_1cziaqw" />
    <serviceTask id="Activity_1t4bki7" name="Add submitted request action" flowable:delegateExpression="#{empVariationAddRegulatorLedApprovedRequestActionHandlerFlowable}">
      <incoming>Flow_0wgfbkz</incoming>
