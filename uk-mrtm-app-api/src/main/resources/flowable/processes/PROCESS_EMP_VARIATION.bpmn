    <sequenceFlow id="Flow_1hdtlcs" sourceRef="Activity_0fqgr7w" targetRef="Activity_1j1xob0" />
    <serviceTask id="Activity_0fqgr7w" name="Update Workflow status to APPROVED" flowable:delegateExpression="#{requestUpdateStatusHandlerFlowable}">
      <extensionElements>
        <flowable:field name="requestStatus">
          <flowable:string>APPROVED</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="Activity_177o5z9" name="Send Official Notice Email" flowable:delegateExpression="#{empVariationSendOfficialNoticeEmailHandlerFlowable}" />
